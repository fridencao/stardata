# 多阶段构建 StarData admin 管理平面镜像
FROM golang:1.26 AS build
WORKDIR /app
# duckdb 等依赖需要 cgo（CGO_ENABLED=1，不能关）。
# golang:1.26 (Debian trixie) 已自带 gcc 与 libc 头文件，无需 apt 安装——
# 早先的 `apt-get install gcc libc6-dev` 只是让构建多依赖一次 deb.debian.org
# 拉取，在网络受限环境下会直接失败（404 / 极慢），故移除。
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -o /stardata ./cli

FROM ubuntu:24.04
# TLS 根证书直接从构建阶段复制，避免运行阶段再依赖 apt 源（网络受限环境下会失败）。
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /stardata /usr/local/bin/stardata
RUN groupadd -g 1001 stardata && useradd -m -u 1001 -s /bin/sh -g stardata stardata
# /data 供持久卷挂载（admin 本地 assets / runtime DuckDB+metastore），预建并授权给运行用户
RUN mkdir -p /data && chown stardata:stardata /data
USER stardata
# 不设置 ENTRYPOINT：由 docker-compose 的 command 控制 "migrate && start" 顺序

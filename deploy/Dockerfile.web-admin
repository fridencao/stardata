# 多阶段构建 StarData web-admin 静态前端
#
# 阶段1: node 安装 monorepo 依赖并构建 SvelteKit 静态产物（adapter-static）
# 阶段2: nginx 托管 build/ 输出，容器内部监听 3002，供 admin-proxy 单源反代（/ -> web-admin:3002）
#
# 注：本地 macOS 的 rolldown 原生层会段错误（见计划 2.1），但 Linux 容器内的 rolldown
# 二进制正常，故容器构建是 web-admin 的可用构建路径。

FROM node:22-alpine AS build
WORKDIR /app

# 复制全部源码（含各 workspace 的 package.json，供 npm ci 解析 monorepo）
COPY . .

# 构建时注入变量：
#   RILL_UI_PUBLIC_RILL_ADMIN_URL -> Vite 客户端可见（envPrefix RILL_UI_PUBLIC_），用于 CSP connect-src 通配与 ADMIN_URL 同源判断
#   RILL_ADMIN_FRONTEND_URL       -> svelte.config.js 读取，localhost 视为 dev（放行 http:），生产应填 https 外部地址
ARG RILL_UI_PUBLIC_RILL_ADMIN_URL=http://localhost:8080
ARG RILL_ADMIN_FRONTEND_URL=http://localhost:3002
ENV RILL_UI_PUBLIC_RILL_ADMIN_URL=$RILL_UI_PUBLIC_RILL_ADMIN_URL
ENV RILL_ADMIN_FRONTEND_URL=$RILL_ADMIN_FRONTEND_URL

# npm 镜像源（默认 npmmirror，规避 registry.npmjs.org 网络抖动导致的 ECONNRESET/EAI_AGAIN）
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN npm ci --registry=$NPM_REGISTRY
RUN npm run build -w web-admin

FROM nginx:1.27-alpine
COPY deploy/nginx/web-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web-admin/build /usr/share/nginx/html
EXPOSE 3002
